#!/usr/bin/env bash
# ==============================================================================
# Deterministic Pre-Commit Leak Guard & Git Hygiene Hook
# Rejects commits containing:
#  1. Hardcoded absolute authoring-machine paths (/Users/*, /home/*, /private/var/*)
#  2. Sensitive API keys, private tokens, or credential strings
#  3. Accidental staging of un-ignored environment files (.env, .env.local, *.pem, *.key)
#  4. Accidental staging of oversized binary files (> 10MB)
# ==============================================================================

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FAILED=0

# 1. Check for staged sensitive / environment files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check for .env or private key files
for file in $STAGED_FILES; do
    if [[ "$file" =~ (\.env|\.env\.local|\.pem|\.key|id_rsa|id_ed25519)$ ]]; then
        echo -e "${RED}❌ ERROR: Attempting to commit sensitive environment/key file: ${file}${NC}"
        echo "   Rule: Add this file to .gitignore and use .env.example with placeholders instead."
        FAILED=1
    fi

    # Check file size (reject > 10MB)
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c < "$file" | tr -d ' ')
        if [ "$FILE_SIZE" -gt 10485760 ]; then
            echo -e "${RED}❌ ERROR: File exceeds 10MB size limit (${FILE_SIZE} bytes): ${file}${NC}"
            echo "   Rule: Large datasets and models should be stored in cloud/LFS, not standard Git history."
            FAILED=1
        fi
    fi
done

# 2. Check for absolute local machine path leaks in added lines
# Matches /Users/<name> or /home/<name> or /private/var/<name>
PATH_LEAKS=$(git diff --cached -U0 | grep -E "^\+[^\+]" | grep -E "(\/Users\/[a-zA-Z0-9_\.-]+|\/home\/[a-zA-Z0-9_\.-]+|\/private\/var\/[a-zA-Z0-9_\.-]+)" || true)

if [ -n "$PATH_LEAKS" ]; then
    echo -e "${RED}❌ ERROR: Detected absolute local machine path leak in staged code!${NC}"
    echo -e "${YELLOW}Offending line(s):${NC}"
    echo "$PATH_LEAKS" | head -n 5
    echo ""
    echo "   Remediation: Replace absolute paths with relative paths (e.g. Path(__file__).resolve().parent) or environment variables."
    FAILED=1
fi

# 3. Check for obvious high-entropy API keys and tokens
SECRET_LEAKS=$(git diff --cached -U0 | grep -E "^\+[^\+]" | grep -E "(sk-ant-[a-zA-Z0-9_-]{20,}|sk-[a-zA-Z0-9]{24,}|ghp_[a-zA-Z0-9]{20,}|gho_[a-zA-Z0-9]{20,}|Bearer [a-zA-Z0-9_\-\.]{25,}|AKIA[0-9A-Z]{16}|xoxb-[0-9]{10,})" || true)

if [ -n "$SECRET_LEAKS" ]; then
    echo -e "${RED}❌ ERROR: Detected potential live API key or authentication token in staged code!${NC}"
    echo -e "${YELLOW}Offending line(s):${NC}"
    echo "$SECRET_LEAKS" | head -n 3
    echo ""
    echo "   Remediation: Store API credentials in environment variables or secret managers, never in code."
    FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo -e "${RED}Commit rejected by Git Hygiene Pre-Commit Guard.${NC}"
    echo "Fix the highlighted issues above before committing."
    exit 1
fi

exit 0
